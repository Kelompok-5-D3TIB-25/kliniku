# ==============================================================================
# KLINIKU — Production Apache .htaccess for InfinityFree (/htdocs)
# ==============================================================================

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. Forward Authorization Header (Wajib untuk Bearer JWT Token pada Apache/FastCGI)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2. KEAMANAN KRUSIAL: Blokir akses langsung ke folder privat Laravel
    RewriteRule ^(app|bootstrap|config|database|routes|storage|vendor)/ - [F,L]

    # 3. RUTE API: Semua panggilan /api/* diarahkan ke Laravel index.php
    RewriteRule ^api(/.*)?$ index.php [L,QSA]

    # 4. FILE ASSET STATIS: Jika file atau direktori fisik ada (index.html, css, js, gambar), layani langsung
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. RUTE FRONTEND: Arahkan seluruh rute halaman lainnya ke index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Keamanan Tambahan: Blokir akses langsung ke file sensitif
<FilesMatch "^\.(env|git|lock|sql|yml|editorconfig)">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokir composer.json, package.json, phpunit.xml
<FilesMatch "^(composer|package|phpunit)\.(json|lock|xml)$">
    Order allow,deny
    Deny from all
</FilesMatch>
